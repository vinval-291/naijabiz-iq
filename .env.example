# WhatsApp alerts through the Twilio WhatsApp Sandbox (optional — the app works without them).
# Copy this file to .env.local and fill in your own values. Never commit .env.local.
#
# 1. Twilio Console → Account Info: Account SID and Auth Token.
# 2. Twilio Console → Messaging → Try it out → Send a WhatsApp message: note the sandbox number
#    and join code, then send "join <code>" from the demo phone on WhatsApp.
# 3. ALERT_WHATSAPP_TO is the ONLY number the app will ever message (the demo phone).

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=whatsapp:+234XXXXXXXXXX
